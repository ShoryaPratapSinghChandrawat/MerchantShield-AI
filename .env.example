# MerchantShield AI - example environment.
# Copy to .env and edit. NEVER commit a real .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# Demo
# ---------------------------------------------------------------------------
# When true: the demo dataset is seeded (only if the database is empty) and the
# /api/demo/* routes exist. When false or unset: no seeding, and every
# /api/demo/* route returns 404.
# Leaving this unset is treated as false AND logs a startup warning, so a
# silent default can never be mistaken for a deliberate choice.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# PayPal - SANDBOX ONLY (rule R4)
# ---------------------------------------------------------------------------
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
# Leave them blank to run entirely on the mock adapter.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The documented Sandbox REST host.
# Source: https://developer.paypal.com/api/orders/v2 ("Base URL(s)")
# The app REFUSES TO START if this is a PayPal production hostname.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# auto    - use Sandbox only if credentials exist AND a token is obtained;
#           otherwise fall back to MOCK and label every record accordingly.
# sandbox - require Sandbox; fail loudly rather than silently mocking.
# mock    - always use the mock adapter. No network calls at all.
PAYPAL_MODE=auto

# ---------------------------------------------------------------------------
# LLM (Phase 6). "none" uses the deterministic fallback and is fully offline.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./merchantshield.db
APP_BASE_URL=http://127.0.0.1:8000
PORT=8000
