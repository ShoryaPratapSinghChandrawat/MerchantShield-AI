# Normalise line endings so a Windows checkout and a Linux CI runner agree.
* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Windows-only helpers keep CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch binaries.
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
*.sqlite3 binary
*.db   binary
